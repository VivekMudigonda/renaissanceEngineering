---
import { Icon } from 'astro-icon/components';

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<header class:list={['site-header', { compact }]}> 
	<nav>
		<a class="index-link" href="/"><Icon name="mdi:menu" class="menu-mark" aria-hidden="true" /> Index </a>
		<a class="brand" href="/"><span>Renaissance</span> <small>Engineering journal</small></a>
		<div class="header-actions"><a href="/blog">Search</a><Icon name="mdi:magnify" class="search-mark" aria-hidden="true" /></div>
	</nav>
</header>
<style>
	.site-header { border-bottom: 1px solid rgba(0, 0, 0, 0.72); background: var(--surface); color: var(--on-surface); }
	nav { max-width: var(--page-width); min-height: 3.8rem; margin: 0 auto; padding: 0.35rem 2rem; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; }
	nav a { text-decoration: none; }
	.index-link, .header-actions { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; }
	.index-link { justify-self: start; display: inline-flex; align-items: center; }
	.menu-mark { width: 1rem; height: 1rem; margin-right: 0.7rem; }
	.brand { position: relative; font-family: var(--font-display); font-size: clamp(1.65rem, 2.8vw, 2.35rem); line-height: 0.9; letter-spacing: -0.05em; text-align: center; white-space: nowrap; }
	.brand em { font-style: italic; font-weight: 400; }
	.brand small { display: block; margin-top: 0.45rem; font-family: var(--font-mono); font-size: 0.3em; letter-spacing: 0.22em; text-transform: uppercase; }
	.header-actions { justify-self: end; display: flex; align-items: center; gap: 0.75rem; }
	.search-mark { width: 1rem; height: 1rem; }
	.compact nav { min-height: 3.4rem; }
	.compact .brand { font-size: clamp(1.45rem, 2.5vw, 2rem); }
	.compact .index-link { opacity: 0.8; }
	@media (max-width: 720px) { .issue-bar { padding-inline: 1rem; font-size: 0.5rem; grid-template-columns: 1fr 1fr; } .issue-bar span:nth-child(2) { display: none; } .issue-bar span:last-child { text-align: right; } nav { min-height: 3.2rem; padding: 0.25rem 1rem; } .brand { font-size: 1.3rem; } .brand small { display: none; } .index-number, .header-actions a { display: none; } }
</style>

---
import { Icon } from 'astro-icon/components';

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<header class:list={['site-header', { compact }]}>
	<div class="header-shell">
		<nav class="header-nav" aria-label="Primary navigation">
			<button class="menu-toggle" type="button" aria-label="Open site menu" aria-expanded="false" aria-controls="site-menu">
				<Icon name="mdi:menu" class="menu-mark" aria-hidden="true" />
				<Icon name="mdi:close" class="menu-close-mark" aria-hidden="true" />
				<span>Menu</span>
			</button>
			<a class="brand" href="/"><span>Renaissance</span> <small>Engineering journal</small></a>
			<a class="header-actions" href="/search" aria-label="Search the journal"><span>Search</span><Icon name="mdi:magnify" class="search-mark" aria-hidden="true" /></a>
		</nav>
		<nav class="site-menu" id="site-menu" aria-label="Site navigation" hidden>
			<p class="menu-heading">Explore</p>
			<a class="menu-item" href="/"><span class="menu-number">01</span><span>Home</span><Icon name="mdi:arrow-top-right" aria-hidden="true" /></a>
			<a class="menu-item" href="/blog/"><span class="menu-number">02</span><span>Blogs</span><Icon name="mdi:arrow-top-right" aria-hidden="true" /></a>
			<a class="menu-item" href="/search"><span class="menu-number">03</span><span>Search</span><Icon name="mdi:arrow-top-right" aria-hidden="true" /></a>
			<a class="menu-item" href="/about"><span class="menu-number">04</span><span>About</span><Icon name="mdi:arrow-top-right" aria-hidden="true" /></a>
		</nav>
	</div>
</header>
<script>
	const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const siteMenu = document.querySelector<HTMLElement>('#site-menu');

	if (menuToggle && siteMenu) {
		const setMenuOpen = (isOpen: boolean) => {
			siteMenu.hidden = !isOpen;
			menuToggle.setAttribute('aria-expanded', String(isOpen));
			menuToggle.setAttribute('aria-label', isOpen ? 'Close site menu' : 'Open site menu');
		};

		menuToggle.addEventListener('click', () => setMenuOpen(siteMenu.hasAttribute('hidden')));
		siteMenu.addEventListener('click', (event) => {
			if (event.target instanceof Element && event.target.closest('a')) setMenuOpen(false);
		});
		document.addEventListener('pointerdown', (event) => {
			if (!siteMenu.hidden && event.target instanceof Node && !siteMenu.contains(event.target) && !menuToggle.contains(event.target)) {
				setMenuOpen(false);
			}
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !siteMenu.hidden) {
				setMenuOpen(false);
				menuToggle.focus();
			}
		});
	}
</script>
<style>
	.site-header { position: relative; z-index: 20; border-bottom: 1px solid rgba(0, 0, 0, 0.72); background: var(--surface); color: var(--on-surface); }
	.header-shell { position: relative; max-width: var(--page-width); margin: 0 auto; }
	.header-nav { min-height: 3.8rem; margin: 0 auto; padding: 0.35rem 2rem; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; }
	.header-nav a { text-decoration: none; }
	.menu-toggle, .header-actions { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; }
	.menu-toggle { justify-self: start; display: inline-flex; align-items: center; gap: 0.7rem; padding: 0; border: 0; background: transparent; color: inherit; cursor: pointer; }
	.menu-mark, .menu-close-mark { width: 1rem; height: 1rem; }
	.menu-close-mark { display: none; }
	.menu-toggle[aria-expanded="true"] .menu-mark { display: none; }
	.menu-toggle[aria-expanded="true"] .menu-close-mark { display: block; }
	.brand { position: relative; font-family: var(--font-display); font-size: clamp(1.65rem, 2.8vw, 2.35rem); line-height: 0.9; letter-spacing: -0.05em; text-align: center; white-space: nowrap; }
	.brand em { font-style: italic; font-weight: 400; }
	.brand small { display: block; margin-top: 0.45rem; font-family: var(--font-mono); font-size: 0.3em; letter-spacing: 0.22em; text-transform: uppercase; }
	.header-actions { justify-self: end; display: flex; align-items: center; gap: 0.75rem; }
	.search-mark { width: 1rem; height: 1rem; }
	.site-menu { position: absolute; z-index: 1; top: 100%; left: 2rem; width: min(26rem, calc(100vw - 4rem)); padding: 0.35rem 0 0.4rem; border: 1px solid rgba(0, 0, 0, 0.72); border-top: 0; background: var(--surface); box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12); }
	.site-menu[hidden] { display: none; }
	.menu-heading { margin: 0; padding: 0.9rem 1rem 0.65rem; color: var(--on-surface-variant); font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.16em; text-transform: uppercase; }
	.menu-item { display: grid; grid-template-columns: 2.4rem 1fr 1rem; align-items: center; gap: 0.7rem; padding: 0.9rem 1rem; border-top: 1px solid rgba(0, 0, 0, 0.16); font-family: var(--font-display); font-size: 1.35rem; line-height: 1; text-decoration: none; }
	.menu-item:hover, .menu-item:focus-visible { background: var(--surface-container-low); }
	.menu-number { color: var(--on-surface-variant); font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.08em; }
	.menu-item svg { width: 0.85rem; height: 0.85rem; color: var(--on-surface-variant); }
	.menu-toggle:focus-visible, .menu-item:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
	.compact .header-nav { min-height: 3.4rem; }
	.compact .brand { font-size: clamp(1.45rem, 2.5vw, 2rem); }
	@media (max-width: 720px) { .issue-bar { padding-inline: 1rem; font-size: 0.5rem; grid-template-columns: 1fr 1fr; } .issue-bar span:nth-child(2) { display: none; } .issue-bar span:last-child { text-align: right; } .header-nav { min-height: 3.2rem; padding: 0.25rem 1rem; } .brand { font-size: 1.3rem; } .brand small { display: none; } .header-actions span { display: none; } .header-actions { gap: 0; } .site-menu { left: 1rem; width: min(26rem, calc(100vw - 2rem)); } }
</style>

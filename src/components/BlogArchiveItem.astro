---
interface Props {
	id: string;
	index: number;
	title: string;
	date: string;
}

const { id, index, title, date } = Astro.props;
---

<a class="archive-item" data-post-id={id} href={`/blog/${id}/`}>
	<span class="archive-number">{String(index).padStart(2, '0')}</span>
	<span>
		<strong>{title}</strong>
		<small>{date}</small>
	</span>
	<span aria-hidden="true">↗</span>
</a>

<style>
	.archive-item { display: grid; grid-template-columns: 2.2rem minmax(0, 1fr) 1rem; gap: 1.1rem; align-items: start; padding: 1.35rem 0.1rem; border-bottom: 1px solid rgba(0, 0, 0, 0.2); text-decoration: none; }
	.archive-item[hidden] { display: none; }
	.archive-item:last-of-type { border-bottom: 0; }
	.archive-item:hover strong { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
	.archive-number, .archive-item > span:last-child, .archive-item small { color: var(--on-surface-variant); }
	.archive-number, .archive-item > span:last-child, .archive-item small { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; }
	.archive-item strong, .archive-item small { display: block; }
	.archive-item strong { font-family: var(--font-display); font-size: clamp(1.8rem, 3vw, 2.7rem); font-weight: 400; line-height: 0.95; letter-spacing: -0.035em; }
	.archive-item small { margin-top: 0.55rem; }
	@media (max-width: 720px) { .archive-item { grid-template-columns: 1.6rem minmax(0, 1fr) 0.8rem; gap: 0.6rem; padding: 1.15rem 0; } .archive-item strong { font-size: 1.8rem; } }
</style>

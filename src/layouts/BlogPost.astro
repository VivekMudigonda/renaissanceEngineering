---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, author = 'Renaissance Engineer', readTime = '5 min read', pubDate, heroImage } = Astro.props;
const formattedPubDate = new Intl.DateTimeFormat('en-US', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
}).format(new Date(pubDate));
---

<html lang="en">
	<head><BaseHead title={title} description={description} type="article" /></head>
	<body>
		<Header compact />
		<main class="article-page">
			<article>
				<header class="article-header">
					<div class="article-heading">
						<p class="article-kicker"><span aria-hidden="true"></span> Architecture of intelligence <b>/</b> Essay 014</p>
						<h1>{title}</h1>
						<p class="article-description">{description}</p>
					</div>
					<aside class="article-meta" aria-label="Article details">
						<div><span>Author</span><strong>{author}</strong></div>
						<div><span>Read time</span><strong>{readTime}</strong></div>
						<div><span>Published</span><strong>{formattedPubDate}</strong></div>
						<div><span>Status</span><strong class="status">In the field</strong></div>
						<div class="article-actions"><button type="button" aria-label="Save article"><Icon name="mdi:bookmark-outline" aria-hidden="true" /> <span>Save</span></button><button type="button" data-share aria-label="Share article"><Icon name="mdi:share-variant-outline" aria-hidden="true" /> <span>Share</span></button></div>
					</aside>
				</header>

				<div class="article-rule"></div>
				{heroImage && <figure class="article-hero"><Image src={heroImage} alt="" /><figcaption>Study 07 / Load path <span>Plate 01</span></figcaption></figure>}
				<div class="prose"><slot /></div>
			</article>
		</main>
		<Footer />
		<script>
			document.querySelector('[data-share]')?.addEventListener('click', async () => {
				if (navigator.share) await navigator.share({ title: document.title, url: window.location.href });
				else await navigator.clipboard.writeText(window.location.href);
			});
		</script>
	</body>
</html>

<style>
	.article-page { max-width: 960px; padding-top: 5rem; }
	.article-header { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 4rem; align-items: start; }
	.article-kicker { display: flex; align-items: center; gap: 0.7rem; margin: 0 0 1.8rem; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--on-surface-variant); }
	.article-kicker span { width: 0.36rem; height: 0.36rem; background: var(--secondary); }
	.article-kicker b { font-weight: 400; opacity: 0.45; }
	.article-heading h1 { max-width: 700px; margin: 0; font-family: var(--font-display); font-size: clamp(3.7rem, 7vw, 6.2rem); font-weight: 400; line-height: 0.86; letter-spacing: -0.055em; }
	.article-description { max-width: 650px; margin: 1.5rem 0 0; font-family: var(--font-display); font-size: clamp(1.4rem, 2.5vw, 2rem); line-height: 1.2; }
	.article-meta { border-left: 1px solid rgba(0, 0, 0, 0.7); padding-left: 1.4rem; }
	.article-meta > div:not(.article-actions) { display: grid; gap: 0.35rem; padding: 0.1rem 0 1rem; margin-bottom: 0.9rem; border-bottom: 1px solid rgba(0, 0, 0, 0.2); }
	.article-meta span, .article-meta strong { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; }
	.article-meta span { color: var(--on-surface-variant); }
	.article-meta strong { font-weight: 500; }
	.status::before { content: ''; display: inline-block; width: 0.38rem; height: 0.38rem; margin-right: 0.5rem; background: var(--secondary); }
	.article-actions { display: flex; gap: 0.45rem; margin-top: 1.6rem; }
	.article-actions button { padding: 0.6rem 0.75rem; border: 1px solid rgba(0, 0, 0, 0.65); background: transparent; font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; }
	.article-actions button { display: inline-flex; align-items: center; gap: 0.4rem; }
	.article-actions svg { width: 0.85rem; height: 0.85rem; }
	.article-actions button:hover { background: var(--primary); color: var(--surface); }
	.article-rule { margin: 5rem 0 3.2rem; border-top: 1px solid rgba(0, 0, 0, 0.65); }
	.article-hero { position: relative; margin: 0 0 3.8rem; padding: 0.7rem; border: 1px solid rgba(0, 0, 0, 0.65); background: var(--surface-container); }
	.article-hero img { width: 100%; aspect-ratio: 1.9; object-fit: cover; mix-blend-mode: multiply; opacity: 0.82; }
	.article-hero figcaption { display: flex; justify-content: space-between; padding-top: 0.7rem; font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase; }
	.prose { width: 100%; max-width: none; margin: 0; font-size: 1.08rem; line-height: 1.78; }
	.prose p { margin: 0 0 1.6em; }
	.prose > p:first-child::first-letter { float: left; padding: 0.3rem 0.7rem 0 0; font-family: var(--font-display); font-size: 5rem; line-height: 0.72; }
	.prose h2, .prose h3 { margin: 2.4em 0 0.7em; font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 400; line-height: 1; letter-spacing: -0.04em; }
	.prose blockquote { margin: 2rem 0; padding-left: 1.2rem; border-left: 1px solid var(--primary); font-family: var(--font-display); font-size: 1.8rem; font-style: italic; line-height: 1.2; }
	.prose pre { overflow-x: auto; padding: 1rem; background: var(--surface-container); font-family: var(--font-mono); font-size: 0.8rem; }
	@media (max-width: 720px) { .article-page { padding-top: 2.8rem; } .article-header { grid-template-columns: 1fr; gap: 2.5rem; } .article-heading h1 { font-size: clamp(3.6rem, 15vw, 5.2rem); } .article-meta { border-left: 0; border-top: 1px solid rgba(0, 0, 0, 0.7); padding: 1.2rem 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; } .article-actions { grid-column: 1 / -1; } .article-rule { margin: 3rem 0 2rem; } .article-hero { margin-inline: 0.2rem; } }
+</style>
